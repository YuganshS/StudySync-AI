# HTTP server and MongoDB
PORT=3001
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/studysync
MONGODB_DB=studysync
DB_NAME=studysync
COLLECTION_NAME=materials

# Required for chatbot answers and document embeddings/OCR.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_DIM=1024

# Optional: files are stored in MongoDB even without Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Chroma service used by the legacy /ingest endpoint.
CHROMA_HOST=localhost
CHROMA_PORT=8001
